hoc <<EOF
a=$1

func sinc(x) {
	if(x == 0) return 1
	return sin(PI*x)/PI*x
}

func withinbounds(x) {
	if(x > -a && x <= a) return 1
	return 0
}

func L(x) {
	if(!withinbounds(x)) return 0
	return sinc(x)*sinc(x/a)
}

func lanczos(x) {
	if(x == 0) return 1
	if(x < -a || x >= a) return 0
	return a*sin(PI*x)*sin(PI*x/a)/(PI^2*x^2)
}

func lanczos2(x, y) {
	if(!withinbounds(x) || !withinbounds(y)) return 0
	return sinc(sqrt(x^2+y^2))*sinc(sqrt(x^2+y^2)/a)
}

